# ============================================
# call_me 环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================

# --- 必填：DashScope API (阿里云) ---
DASHSCOPE_API_KEY=sk-xxx

# --- 必填：LiveKit Cloud ---
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# --- 可选：DeepSeek API (如使用 DeepSeek LLM) ---
# DEEPSEEK_API_KEY=sk-xxx

# --- 管理员账号 (首次启动自动创建) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- JWT 签名密钥 (请改为随机字符串) ---
JWT_SECRET=changeme

# --- STT 语音识别 ---
# 提供商: livekit (Deepgram) 或 qwen (通义 ASR)
STT_PROVIDER=livekit
STT_MODEL=deepgram/nova-2
STT_LANGUAGE=zh-CN

# --- LLM 大语言模型 ---
# 提供商: qwen (通义千问) 或 deepseek (DeepSeek)
LLM_PROVIDER=qwen
# QWEN_MODEL=qwen3-max
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- TTS 语音合成 ---
# 提供商: qwen (通义 TTS) 或 elevenlabs
TTS_PROVIDER=qwen
# VC 实时流式模型 (支持声音复刻 + 内置音色)
QWEN_TTS_MODEL=qwen3-tts-vc-realtime-2026-01-15
# 默认音色 (内置: Cherry, Stella 等; 复刻: qwen-tts-vc-myvoice-xxx)
QWEN_TTS_VOICE=Cherry

# --- 种子 Agent (可选，启动时自动创建) ---
# 取消注释以启用
# SEED_AGENT_ALIAS=温柔客服
# SEED_AGENT_SYSTEM_PROMPT=你是一位温柔耐心的客服助手
# SEED_AGENT_VOICE=Cherry
# SEED_AGENT_OWNER=admin
