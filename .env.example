# call_me 环境变量
# 复制为 .env，把 xxx 替换成真实值
#
# 配置逻辑：
#   首次启动 → .env 中有值的项目自动写入数据库
#   后续运行 → 所有配置在 Web Admin 页面管理，.env 不再影响
#   Web Admin: http://localhost:8000/admin/

# ============================================================
# 必填（缺少任意一个服务无法启动）
# ============================================================

# 阿里云 DashScope API Key — 获取: https://dashscope.console.aliyun.com/apiKey
# 本示例必须保持占位符；不要把真实生产密钥提交到仓库。
DASHSCOPE_API_KEY=sk-xxx

# Qwen Audio TTS（经典 Pipeline 与后台试听）需要工作区专属 HTTP 端点。
# API 与 Agent Worker 都读取这两个变量；API Key、workspace、endpoint 必须同区域。
# DASHSCOPE_WORKSPACE=llm-xxxxxxxxxxxxxxxx
# QWEN_AUDIO_TTS_API_URL=https://llm-xxxxxxxxxxxxxxxx.cn-beijing.maas.aliyuncs.com/api/v1/services/audio/tts/SpeechSynthesizer

# 端到端实时 Qwen 配置：
# endpoint 和 region 不是全局环境变量。请在 Web Admin 的“实时模型”中为每条
# realtime_configs 记录填写匹配区域的 wss:// endpoint、region 标签，并关联 API Key。
# 音色复刻结果是模型专属的内部绑定；不要将提供商音色 ID 写入 .env、客户端或日志。

# LiveKit Cloud 项目 — 获取: https://cloud.livekit.io
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# 自建 LiveKit Server 时必填：节点公网 IP（docker-compose 中 --node-ip 插值）
# 另需复制 livekit.yaml.example 为 livekit.yaml 并填入同一组 key/secret
# LIVEKIT_NODE_IP=x.x.x.x

# ============================================================
# 建议修改（不改就用默认值，但生产环境有安全风险）
# ============================================================

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=changeme

# Agent Worker 内网鉴权（与 API 共享；不配则回退为 JWT_SECRET）
# WORKER_INTERNAL_SECRET=changeme-worker-secret

# ============================================================
# 可选：首次启动自动写入数据库（取消注释才生效）
# 不配的项目留空，之后去 Web Admin 手动创建
# ============================================================

# 额外 API Key — 取消注释即自动创建对应记录
# DEEPSEEK_API_KEY=sk-xxx

# 内置音色 — 取消注释即自动创建，逗号分隔
# SEED_BUILTIN_VOICES=Cherry,Stella,Luna,Scott,Kevin

# TTS 模型 — 取消注释即自动创建，各自独立，需要哪个配哪个
# SEED_TTS_FLASH_MODEL=qwen-audio-3.1-tts-flash   → 创建"通义通用TTS"
# 旧的 qwen3-tts-vc-realtime-* 模型已被服务商下线，不要再用于新部署。
# SEED_TTS_VC_MODEL=qwen-audio-3.1-tts-flash

# LLM 模型 — 取消注释即自动创建一条默认 LLM 模型记录
# DEFAULT_LLM_MODEL=qwen-plus

# 示例 Agent — 取消注释即自动创建一个示例机器人
# 人设（system prompt）请在 Web Admin 的 Agent 页面配置，不在 .env 中设置。
# SEED_AGENT_ALIAS=温柔客服
# SEED_AGENT_VOICE=Cherry
# SEED_AGENT_OWNER=admin

# ============================================================
# STT 语音识别（全局配置，所有 Agent 共用）
# ============================================================

STT_PROVIDER=livekit
STT_MODEL=deepgram/nova-2
STT_LANGUAGE=zh-CN

# ============================================================
# Agent Worker 回退值（仅数据库完全为空时生效，正常不需要管）
# ============================================================

# DEFAULT_LLM_TEMPERATURE=0.7
# DEFAULT_MAX_TOKENS=2048
