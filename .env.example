# ============================================
# call_me 环境变量配置
# 复制为 .env 并填入真实值
# ============================================

# --- 必填：DashScope API (阿里云) ---
DASHSCOPE_API_KEY=sk-xxx

# --- 必填：LiveKit Cloud ---
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# --- 管理员账号 (首次启动自动创建) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- JWT 签名密钥 ---
JWT_SECRET=changeme

# ============================================
# 语音管线配置
# ============================================

# --- STT 语音识别 ---
# 提供商: livekit (Deepgram) 或 qwen (通义 ASR)
STT_PROVIDER=livekit
STT_MODEL=deepgram/nova-2
STT_LANGUAGE=zh-CN

# --- LLM 大语言模型 ---
# 提供商: qwen (通义千问) 或 deepseek (DeepSeek)
LLM_PROVIDER=qwen
# 模型: qwen3-max, qwen-plus 等
# QWEN_MODEL=qwen3-max
# DeepSeek 需设置 DEEPSEEK_API_KEY

# --- TTS 语音合成 ---
# 提供商: qwen (通义 TTS) 或 elevenlabs
TTS_PROVIDER=qwen
# VC 实时流式模型 (支持声音复刻 + 内置音色)
# 可选: qwen3-tts-vc-realtime, qwen3-tts-flash-realtime, qwen-tts 等
QWEN_TTS_MODEL=qwen3-tts-vc-realtime
# 默认音色 (内置: Cherry, Stella 等)
QWEN_TTS_VOICE=Cherry

# ============================================
# 种子 Agent (可选，启动时自动创建)
# ============================================
# SEED_AGENT_ALIAS=温柔客服
# SEED_AGENT_SYSTEM_PROMPT=你是一位温柔耐心的客服助手
# SEED_AGENT_VOICE=Cherry
# SEED_AGENT_OWNER=admin
