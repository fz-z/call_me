# call_me 环境变量
# 复制为 .env，把 xxx 替换成真实值即可运行
#
# 如何获取 Key：
#   DashScope: https://dashscope.aliyun.com/ → API-KEY 管理
#   LiveKit:   https://cloud.livekit.io/ → Project Settings → Keys

# --- 必填：DashScope (阿里云) ---
DASHSCOPE_API_KEY=sk-xxx

# --- 必填：LiveKit Cloud ---
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=APIxxx
LIVEKIT_API_SECRET=xxx

# --- 可选：DeepSeek (使用 deepseek LLM 时) ---
# DEEPSEEK_API_KEY=sk-xxx

# --- 管理员 ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=changeme

# --- 语音管线 ---
STT_PROVIDER=livekit
STT_MODEL=deepgram/nova-2
STT_LANGUAGE=zh-CN

LLM_PROVIDER=qwen
# QWEN_MODEL 默认 qwen3-max，可不设

TTS_PROVIDER=qwen
QWEN_TTS_MODEL=qwen3-tts-vc-realtime-2026-01-15
QWEN_TTS_VOICE=Cherry

# --- 种子 Agent (可选，取消注释启用) ---
# SEED_AGENT_ALIAS=温柔客服
# SEED_AGENT_SYSTEM_PROMPT=你是一位温柔耐心的客服助手
# SEED_AGENT_VOICE=Cherry
# SEED_AGENT_OWNER=admin
